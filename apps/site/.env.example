# URL of the contact form's backend (apps/dashboard's /api/contact route).
# Must be PUBLIC_-prefixed to be exposed to client-side code (see
# src/components/ContactForm.tsx). Baked in at build time.
PUBLIC_CONTACT_API_URL=https://your-dashboard.vercel.app/api/contact

# Copy this file to .env and fill in the real deployed dashboard URL.
# .env is gitignored — never commit real values.
