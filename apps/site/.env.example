# URL of the contact form's backend (apps/dashboard's /api/contact route).
# Must be PUBLIC_-prefixed to be exposed to client-side code (see
# src/components/ContactForm.tsx). Baked in at build time.
#
# Production value is set directly in .github/workflows/deploy-site.yml
# (GitHub Actions doesn't read this .env file) — this is only for local dev.
PUBLIC_CONTACT_API_URL=http://localhost:3000/api/contact

# Powers the partner-with-us form (src/components/PartnerEnquiryForm.tsx).
#
# HubSpot's Forms Submission API is public/CORS-enabled (no secret key), so
# the portalId + formGuid pair is safe to expose here — it only works because
# a matching form already exists in the HubSpot account (Marketing → Forms,
# form named "Partner with us"), with a field for every name
# PartnerEnquiryForm.tsx sends: email, firstname, lastname, phone, jobtitle,
# company, country (standard contact properties), plus custom properties
# team_size, partner_intent (multiple checkboxes; options wellbeing/retreats/
# individual/curious, submitted as a `;`-joined list), and enquiry_message.
# Fields not on the form are silently rejected, not stored blank. There's
# only one HubSpot account/form (no separate dev vs. prod), so these are the
# same real values used in production (.github/workflows/deploy-site.yml).
PUBLIC_HUBSPOT_PORTAL_ID=149149943
PUBLIC_HUBSPOT_PARTNER_FORM_GUID=fc942536-05b9-4099-ba88-0462e575e367
  
# Powers the become-a-host form (src/components/HostApplicationForm.tsx) —
# same mechanism as above, same HubSpot portal, but a separate form (still
# needs creating in HubSpot) with fields: email, firstname, lastname, phone,
# city, country (standard contact properties), plus custom properties
# property_name, property_type, guest_capacity, bedrooms,
# work_ready_features (multiple checkboxes — wifi/desk/quiet/kitchen/nature/
# coffee, submitted as a `;`-joined list), work_ready_other, availability,
# airbnb_url, booking_url, space_story. Blank until that form exists — until
# then the form shows its generic error state on submit instead of hanging
# or silently failing.
PUBLIC_HUBSPOT_HOST_FORM_GUID=

# Copy this file to .env for local dev. .env is gitignored — never commit
# real values there, though none of these are sensitive (they're public IDs
# that end up in the built JS bundle regardless).
