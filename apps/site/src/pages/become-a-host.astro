---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import HostApplicationForm from "../components/HostApplicationForm.tsx";
import zeroRatesIcon from "../assets/images/benefit-icon-hosts-zero-rates.png";
import featuredIcon from "../assets/images/benefit-icon-hosts-featured.png";
import coCreateIcon from "../assets/images/benefit-icon-hosts-co-create.png";
import lowerFeesIcon from "../assets/images/benefit-icon-lower-cost.png";

const benefits = [
	{
		icon: zeroRatesIcon,
		title: "0% rates",
		description: "Rates at 0% for the first free months.",
	},
	{
		icon: featuredIcon,
		title: "Featured listing everyone sees",
		description: "On our homepage, in our launch press.",
	},
	{
		icon: coCreateIcon,
		title: "Co-create the platform with us",
		description: "Your feedback shapes the product.",
	},
	{
		icon: lowerFeesIcon,
		title: "Lower lifetime fees for founding hosts",
		description: "Locked in for as long as you host with us.",
	},
];
---

<Layout
	title="Become a host"
	description="Be one of the first hosts in Poland — apply to become a founding HelloWale host."
	showNav={false}
	currentPath="become-a-host"
>
	<div class="bg-wale-50 min-h-screen">
		<div class="px-4 pt-6 sm:px-10 lg:px-20">
			<Nav variant="floating" currentPath="become-a-host" />
		</div>

		<section class="mx-auto max-w-7xl px-4 py-10 sm:px-10 lg:px-20 lg:py-14">
			<div class="flex flex-col gap-10 lg:flex-row lg:gap-20">
				<div class="w-full shrink-0 overflow-hidden rounded-t-4xl rounded-bl-4xl bg-linear-to-t from-[#914d61] to-[#380121] px-8 py-12 text-white lg:w-[42%] lg:self-start lg:px-14 lg:py-16">
					<h1 class="font-display text-4xl leading-[1.2] font-bold tracking-[-0.8px] text-white">
						Be one of the first hosts in Poland.
					</h1>
					<p class="mt-6 font-display text-base leading-[1.6] text-wale-peach/90">
						We're onboarding founding hosts personally, small group, big benefits. Share your
						details and we'll get back within a few days.
					</p>
					<div class="mt-8 rounded-xl border border-white/12 bg-white/6 px-6 py-8">
						<p class="font-display text-xs font-bold tracking-[0.36px] text-wale-peach/85">
							✳ FOUNDING HOST BENEFITS
						</p>
						<ul class="mt-5 flex flex-col gap-5">
							{
								benefits.map((benefit) => (
									<li class="flex items-center gap-4">
										<img src={benefit.icon.src} alt="" class="size-9 shrink-0" />
										<span class="flex flex-col gap-0.5">
											<span class="font-display text-sm font-bold leading-[1.3] text-white">
												{benefit.title}
											</span>
											<span class="font-display text-xs leading-[1.4] text-white/70">
												{benefit.description}
											</span>
										</span>
									</li>
								))
							}
						</ul>
					</div>
					<p class="mt-6 font-display text-xs text-wale-peach/80">
						✳ Listing is free. We respond within 48 hours.
					</p>
				</div>

				<div class="flex-1">
					<div class="pb-6">
						<h2 class="font-display text-wale-800 text-[28px] font-bold tracking-[-0.224px]">
							Founding host application
						</h2>
						<p class="mt-2 text-base text-wale-800/65">
							Takes about 4 minutes. Fields with * are required.
						</p>
					</div>
					<HostApplicationForm client:load />
				</div>
			</div>
		</section>
	</div>
</Layout>
