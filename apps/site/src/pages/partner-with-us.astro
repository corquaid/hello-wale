---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import PartnerEnquiryForm from "../components/PartnerEnquiryForm.tsx";

const benefits = [
	"Lowest subscription we'll ever offer locked in forever",
	"Half-price booking rates for your employees",
	"Co-create the platform with us",
	"Featured as a launch partner",
];
---

<Layout
	title="Partner with us"
	description="Let's build your team's workation programme together — partner with HelloWale as a founding company."
	showNav={false}
	currentPath="partner-with-us"
>
	<div class="bg-wale-50 min-h-screen">
		<div class="px-4 pt-6 sm:px-10 lg:px-20">
			<Nav variant="floating" currentPath="partner-with-us" />
		</div>

		<section class="mx-auto max-w-7xl px-4 py-10 sm:px-10 lg:px-20 lg:py-14">
			<div class="flex flex-col gap-10 lg:flex-row lg:gap-20">
				<div
					class="w-full shrink-0 overflow-hidden rounded-t-4xl rounded-bl-4xl bg-linear-to-t from-[#914d61] to-[#380121] px-8 py-12 text-white lg:w-[42%] lg:self-start lg:px-14 lg:py-16"
				>
					<h1 class="font-display text-4xl leading-[1.2] font-bold tracking-[-0.8px] text-white">
						Let's build your team's workation programme together.
					</h1>
					<p class="font-display text-wale-peach/90 mt-6 text-base leading-[1.6]">
						We're partnering with forward-thinking companies to shape what workation-as-a-benefit
						looks like. Get in early and get founding conditions for life.
					</p>
					<div class="mt-8 rounded-xl border border-white/12 bg-white/6 px-6 py-8">
						<p class="font-display text-wale-peach/85 text-xs font-bold tracking-[0.36px]">
							FOUNDING HOST BENEFITS
						</p>
						<ul class="mt-5 flex flex-col gap-5">
							{
								benefits.map((benefit, index) => (
									<li class="flex items-center gap-4">
										<span class="bg-wale-peach text-wale-700 flex size-8 shrink-0 items-center justify-center rounded-full text-sm font-bold">
											{index + 1}
										</span>
										<span class="font-display text-sm leading-[1.4] font-medium text-white/95">
											{benefit}
										</span>
									</li>
								))
							}
						</ul>
					</div>
				</div>

				<div class="flex-1">
					<div class="pb-6">
						<h2 class="font-display text-wale-800 text-[28px] font-bold tracking-[-0.224px]">
							Partnership enquiry
						</h2>
						<p class="text-wale-800/65 mt-2 text-base">
							Fill in a few details — takes about 2 minutes.
						</p>
					</div>
					<PartnerEnquiryForm client:load />
				</div>
			</div>
		</section>
	</div>
</Layout>
