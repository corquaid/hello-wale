---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import BlogHero from "@/components/BlogHero.astro";
import BlogTopics from "@/components/BlogTopics.astro";
import BlogPostCard from "@/components/BlogPostCard.astro";
import BlogCta from "@/components/BlogCta.astro";
import BlogPagination from "@/components/BlogPagination.astro";

export const getStaticPaths = (async ({ paginate }) => {
	const posts = (await getCollection("blog", ({ data }) => data.lang !== "pl")).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	return paginate(posts, { pageSize: 8 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const base = import.meta.env.BASE_URL;

const allPosts = (await getCollection("blog", ({ data }) => data.lang !== "pl")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [featured, ...sidebar] = allPosts.slice(0, 4);

const firstRow = page.data.slice(0, 4);
const secondRow = page.data.slice(4, 8);
---

<Layout
	title="Blog"
	description="Stories on remote work, wellbeing, and the future of work-travel."
	navVariant="floating"
	lang="en"
	currentPath="blog"
>
	{page.currentPage === 1 && featured && <BlogHero featured={featured} sidebar={sidebar} />}

	<BlogTopics />

	<section class="px-6 py-10 sm:px-10 lg:px-20">
		<div class="mx-auto flex max-w-7xl flex-col gap-10">
			<p class="font-display text-2xl leading-tight text-[#0a1633] sm:text-[32px]">All articles</p>

			<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
				{firstRow.map((post) => <BlogPostCard post={post} />)}
			</div>
		</div>
	</section>

	{
		secondRow.length > 0 && (
			<>
				<BlogCta />
				<section class="px-6 pb-10 sm:px-10 lg:px-20">
					<div class="mx-auto grid max-w-7xl grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
						{secondRow.map((post) => (
							<BlogPostCard post={post} />
						))}
					</div>
				</section>
			</>
		)
	}

	<section class="px-6 pb-16 sm:px-10 lg:px-20">
		<div class="mx-auto max-w-7xl">
			<BlogPagination page={page} basePath={`${base}blog`} />
		</div>
	</section>
</Layout>
