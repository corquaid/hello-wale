---
import { Image } from "astro:assets";
import hostsBg from "../assets/images/hosts-bg.jpg";
import iconZeroRates from "../assets/images/benefit-icon-hosts-zero-rates.png";
import iconCoCreate from "../assets/images/benefit-icon-hosts-co-create.png";
import iconFeatured from "../assets/images/benefit-icon-hosts-featured.png";
import CtaButton from "./CtaButton.astro";

const benefitIcons: Record<string, ImageMetadata> = {
	"zero-rates": iconZeroRates,
	"co-create": iconCoCreate,
	featured: iconFeatured,
};

interface Benefit {
	icon: string;
	title: string;
	description: string;
}

interface Props {
	eyebrow?: string;
	headline?: string;
	paragraph?: string;
	benefits?: Benefit[];
	ctaLabel?: string;
}

const {
	eyebrow = "For hosts",
	headline = "Be one of the first\nhosts in Poland.",
	paragraph = "We're partnering with a small group of founding hosts to shape what HelloWale becomes. Get in early, help us design it, and earn exclusive launch benefits for life.",
	benefits = [
		{
			icon: "zero-rates",
			title: "0% rates",
			description: "Rates at 0% for the first free months.",
		},
		{
			icon: "co-create",
			title: "Co-create the platform with us",
			description: "Your feedback shapes the product.",
		},
		{
			icon: "featured",
			title: "Featured listing everyone sees",
			description: "On our homepage, in our launch press.",
		},
	],
	ctaLabel = "List your property - it's free",
} = Astro.props;
---

<section class="relative isolate flex min-h-[80vh] items-center overflow-hidden sm:min-h-[85vh] lg:aspect-3024/1654 lg:min-h-0">
	<Image
		src={hostsBg}
		alt=""
		class="absolute inset-0 -z-10 h-full w-full object-cover object-center"
		widths={[768, 1200, 1600, 2400]}
		sizes="100vw"
	/>

	<div class="mx-auto flex w-full max-w-7xl flex-col gap-12 px-6 py-20 sm:px-10 lg:flex-row lg:items-center lg:justify-between lg:gap-24 lg:px-6 lg:py-30">
		<div class="flex w-full flex-col items-start gap-6 rounded-3xl bg-white/85 lg:bg-transparent p-6 backdrop-blur-sm lg:backdrop-blur-none lg:w-130">
			<p class="font-display text-[11px] tracking-[0.33px] text-wale-700 uppercase">
				{eyebrow}
			</p>
			<p class="font-display text-4xl leading-tight font-bold tracking-[-0.66px] text-wale-700 sm:text-5xl lg:text-[44px] lg:leading-13.5">
				{
					headline.split("\n").map((line, index) => (
						<>
							{index > 0 && <br />}
							{line}
						</>
					))
				}
			</p>
			<p class="max-w-lg font-display text-[17px] leading-7 text-[#5f5f5f]">
				{paragraph}
			</p>
			<CtaButton label={ctaLabel} class="min-w-64" />
		</div>

		<div class="flex w-full flex-col gap-4 lg:w-88">
			{
				benefits.map((benefit) => (
					<div class="flex items-center gap-4 rounded-xl bg-white p-5 shadow-sm">
						<img
							src={benefitIcons[benefit.icon]?.src}
							alt=""
							class="h-10 w-10 shrink-0 object-contain"
						/>
						<div class="flex flex-col items-start gap-0.5">
							<p class="font-display text-[15px] font-bold tracking-[-0.045px] text-[#131313]">
								{benefit.title}
							</p>
							<p class="font-display text-[13px] leading-4.5 text-[#888785]">
								{benefit.description}
							</p>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
