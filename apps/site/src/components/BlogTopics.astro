---
import { BLOG_TOPICS, getTopicLabel } from "@/content/blog-topics";
import type { Locale } from "@/i18n/utils";

interface Props {
	activeSlug?: string;
	heading?: string;
	lang?: Locale;
}

const { activeSlug, heading = "Choose by topic", lang = "en" } = Astro.props;
const base = import.meta.env.BASE_URL;
const blogBase = `${base}${lang === "pl" ? "pl/" : ""}blog`;
---

<section class="px-6 py-10 sm:px-10 lg:px-20">
	<div class="mx-auto flex max-w-7xl flex-col gap-10">
		<p class="font-display text-2xl leading-tight text-[#0a1633] sm:text-[32px]">{heading}</p>
		<div class="flex flex-wrap gap-3">
			{
				BLOG_TOPICS.map(topic => (
					<a
						href={`${blogBase}/topic/${topic.slug}`}
						class:list={[
							"rounded-full px-5 py-2.5 font-display text-sm transition-colors",
							topic.slug === activeSlug ? "bg-wale-700 text-white" : "bg-[#ffe7d3] text-wale-700 hover:bg-wale-peach",
						]}
					>
						{getTopicLabel(topic.slug, lang)}
					</a>
				))
			}
		</div>
	</div>
</section>
