---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	images?: ImageMetadata[];
}

const { images = [] } = Astro.props;
---

{
	images.length > 0 && (
		<div class="mt-16 grid grid-cols-1 gap-6 sm:grid-cols-2">
			{images.map((image, index) => {
				const isCenterBlock = images.length % 2 === 1 && index === images.length - 1;
				const isRightColumn = !isCenterBlock && index % 2 === 1;
				return (
					<div
						class:list={[
							"overflow-hidden rounded-3xl",
							isCenterBlock ? "aspect-video sm:col-span-2" : "aspect-4/5",
							isRightColumn && "sm:mt-12",
						]}
					>
						<Image
							src={image}
							alt=""
							class="h-full w-full object-cover"
							widths={[400, 700, 1000]}
							sizes={
								isCenterBlock ? "(min-width: 640px) 90vw, 90vw" : "(min-width: 640px) 45vw, 90vw"
							}
						/>
					</div>
				);
			})}
		</div>
	)
}
