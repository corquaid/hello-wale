---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { getTopicLabel } from "@/content/blog-topics";
import { formatPostDate, getReadingTime } from "@/lib/blog";
import logoIcon from "@/assets/images/logo-icon-secondary.png";

interface Props {
	post: CollectionEntry<"blog">;
	author?: string;
}

const { post, author = "HelloWale Team" } = Astro.props;
---

<div class="flex flex-col items-start gap-4">
	<div class="flex flex-wrap gap-2">
		{
			post.data.categories.map(category => (
				<span class="rounded-full bg-[#ffe7d3] px-4 py-2 font-display text-xs font-medium text-wale-700">
					{getTopicLabel(category)}
				</span>
			))
		}
	</div>
	<h1 class="font-display text-3xl leading-tight text-wale-700 sm:text-4xl">{post.data.title}</h1>
	<div class="flex items-center gap-4">
		<span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-wale-700 p-2.5">
			<Image src={logoIcon} alt="" class="h-full w-full object-contain" />
		</span>
		<div class="flex flex-col gap-1">
			<p class="font-display text-sm text-[#0a1633]">{author}</p>
			<p class="text-xs text-[#0a1633]">
				Published: {formatPostDate(post.data.pubDate)} · {getReadingTime(post.body)}
			</p>
		</div>
	</div>
</div>
