---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { getTopicLabel } from "@/content/blog-topics";
import { formatPostDate, getReadingTime } from "@/lib/blog";
import type { Locale } from "@/i18n/utils";
import logoIcon from "@/assets/images/logo-icon-secondary.png";

interface Props {
	post: CollectionEntry<"blog">;
	author?: string;
	lang?: Locale;
}

const { post, author, lang = "en" } = Astro.props;
const authorName = author ?? (lang === "pl" ? "Zespół HelloWale" : "HelloWale Team");
const publishedLabel = lang === "pl" ? "Opublikowano" : "Published";
---

<div class="flex flex-col items-start gap-4">
	<div class="flex flex-wrap gap-2">
		{
			post.data.categories.map((category) => (
				<span class="font-display text-wale-700 rounded-full bg-[#ffe7d3] px-4 py-2 text-xs font-medium">
					{getTopicLabel(category, lang)}
				</span>
			))
		}
	</div>
	<h1 class="font-display text-wale-700 text-3xl leading-tight sm:text-4xl">{post.data.title}</h1>
	<div class="flex items-center gap-4">
		<span class="bg-wale-700 flex size-12 shrink-0 items-center justify-center rounded-full p-2.5">
			<Image src={logoIcon} alt="" class="h-full w-full object-contain" />
		</span>
		<div class="flex flex-col gap-1">
			<p class="font-display text-sm text-[#0a1633]">{authorName}</p>
			<p class="text-xs text-[#0a1633]">
				{publishedLabel}: {formatPostDate(post.data.pubDate, lang)} · {
					getReadingTime(post.body, lang)
				}
			</p>
		</div>
	</div>
</div>
