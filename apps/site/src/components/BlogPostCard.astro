---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { getTopicLabel } from "@/content/blog-topics";
import { formatPostDate, getReadingTime } from "@/lib/blog";
import type { Locale } from "@/i18n/utils";

interface Props {
	post: CollectionEntry<"blog">;
	variant?: "grid" | "sidebar";
	lang?: Locale;
}

const { post, variant = "grid", lang = "en" } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}${lang === "pl" ? "pl/" : ""}blog/${post.id}`;
const meta = `${formatPostDate(post.data.pubDate, lang)}  ·  ${getReadingTime(post.body, lang)}`;
---

{
	variant === "grid" ? (
		<a
			href={href}
			class="group flex flex-col overflow-hidden rounded-3xl transition-opacity hover:opacity-90"
		>
			<div class="h-48 w-full overflow-hidden rounded-3xl">
				<Image
					src={post.data.heroImage}
					alt=""
					class="h-full w-full object-cover"
					widths={[320, 480, 640]}
					sizes="(min-width: 1024px) 25vw, 90vw"
					loading="lazy"
				/>
			</div>
			<div class="flex flex-1 flex-col justify-center p-8">
				<div class="flex flex-col items-start gap-3">
					<div class="flex flex-wrap gap-1.5">
						{post.data.categories.map((category) => (
							<span class="font-display text-wale-700 rounded-full bg-[#ffe7d3] px-2.5 py-1.5 text-[10px]">
								{getTopicLabel(category, lang)}
							</span>
						))}
					</div>
					<p class="font-display text-base leading-tight text-[#0f1d3a]">{post.data.title}</p>
					<p class="text-xs text-[#5c6680]">{meta}</p>
				</div>
			</div>
		</a>
	) : (
		<a href={href} class="flex flex-1 items-center gap-6 p-8 transition-opacity hover:opacity-90">
			<div class="size-29 shrink-0 overflow-hidden rounded-2xl">
				<Image
					src={post.data.heroImage}
					alt=""
					class="h-full w-full object-cover"
					widths={[116, 232]}
					sizes="116px"
					loading="lazy"
				/>
			</div>
			<div class="font-display flex flex-1 flex-col gap-4">
				<p class="text-base leading-tight text-[#0f1d3a]">{post.data.title}</p>
				<p class="text-xs text-[#5c6680]">{meta}</p>
			</div>
		</a>
	)
}
