---
import type { CollectionEntry } from "astro:content";

interface Props {
	post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<article class="py-6">
	<a href={`${base}blog/${post.id}`} class="font-display text-xl font-semibold text-wale-800 hover:text-wale-700">
		{post.data.title}
	</a>
	<p class="mt-1 text-sm text-slate-500">
		{
			post.data.pubDate.toLocaleDateString("en-US", {
				year: "numeric",
				month: "long",
				day: "numeric",
			})
		}
	</p>
	<p class="mt-2 text-slate-600">{post.data.description}</p>
</article>
