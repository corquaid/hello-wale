---
import companiesDesk from "@/assets/images/bigger-picture.png";
import companiesHeroPhoto from "@/assets/images/companies-page-hero.png";
import companiesHeroMobile from "@/assets/images/companies-hero-bg-mobile.jpg";
import scienceFocus from "@/assets/images/science-of-change-1.png";
import scienceIdeas from "@/assets/images/science-of-change-2.png";
import scienceEnergyCompanies from "@/assets/images/companies-science-of-change-3.jpg";
import usecaseMarketing from "@/assets/images/usecase-marketing.jpg";
import usecaseTechteam from "@/assets/images/usecase-techteam-2.jpg";
import { useTranslations, type Locale } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";
import ForCompanies from "../ForCompanies.astro";
import Hero from "../Hero.astro";
import HowItWorks from "../HowItWorks.astro";
import ScienceOfChange from "../ScienceOfChange.astro";
import UseCases from "../UseCases.astro";
import WhyWellbeing from "../WhyWellbeing.astro";

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const dict = useTranslations(lang);
const { common } = dict;
const t = dict.companiesPage;

const useCaseImages = [usecaseMarketing, usecaseTechteam];
const useCases = t.useCases.items.map((item, index) => ({
	...item,
	image: useCaseImages[index],
}));
---

<Layout
	title={t.meta.title}
	description={t.meta.description}
	showNav={false}
	lang={lang}
	currentPath="companies"
>
	<Hero
		beforeText={t.hero.beforeText}
		bubbleText={t.hero.bubbleText}
		afterText={t.hero.afterText}
		subtext={t.hero.subtext}
		photo={companiesHeroPhoto}
		mobilePhoto={companiesHeroMobile}
		showPhoto={true}
		photoScale={1.15}
		photoOrigin="bottom"
		contentPosition="end"
		ctas={[
			{ label: t.hero.ctaMaroon, variant: "maroon" },
			{ label: t.hero.ctaPeach, variant: "peach" },
		]}
		lang={lang}
		currentPath="companies"
	/>
	<HowItWorks
		eyebrow={t.howItWorks.eyebrow}
		headline={t.howItWorks.headline}
		subtext={t.howItWorks.subtext}
		steps={t.howItWorks.steps}
		ctaLabel={t.howItWorks.ctaLabel}
	/>
	<section class="bg-white px-6 py-16 text-center sm:py-16">
		<p class="font-display text-3xl font-bold tracking-[-0.96px] text-wale-700 sm:text-4xl lg:text-5xl">
			{t.biggerPicture}
		</p>
	</section>
	<ForCompanies
		eyebrow={common.forCompanies.eyebrow}
		headline={common.forCompanies.headline}
		subtext={common.forCompanies.subtext}
		image={companiesDesk}
		imageAlt="A standing desk with a laptop and monitor overlooking green hills through a window"
		imageLayout="compact"
		benefits={common.forCompanies.benefits}
		ctaLabel={common.forCompanies.ctaLabel}
	/>
	<WhyWellbeing
		eyebrow={common.whyWellbeing.eyebrow}
		headline={common.whyWellbeing.headline}
		subtext={common.whyWellbeing.subtext}
		stats={common.whyWellbeing.stats}
		sourceLabel={common.whyWellbeing.sourceLabel}
	/>
	<UseCases
		eyebrow={common.useCases.eyebrow}
		headline={common.useCases.headline}
		subtext={common.useCases.subtext}
		useCases={useCases}
	/>
	<ScienceOfChange
		eyebrow={common.scienceOfChange.eyebrow}
		headline={common.scienceOfChange.headline}
		subtext={common.scienceOfChange.subtext}
		cards={common.scienceOfChange.cards}
		images={[scienceFocus, scienceIdeas, scienceEnergyCompanies]}
	/>
</Layout>
