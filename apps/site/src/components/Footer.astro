---
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import logoLight from "../assets/images/logo-horizontal-secondary.png";
import ctaCompaniesIcon from "../assets/images/footer-cta-companies.png";
import ctaHostsIcon from "../assets/images/footer-cta-hosts.png";
import ctaGuestsIcon from "../assets/images/footer-cta-guests.png";
import euEmblem from "../assets/images/eu-emblem.svg";
import fuTourismLogo from "../assets/images/FU-TOURISM-Logo-(1200x230)-transparent-white.png";
import { useTranslations, type Locale } from "../i18n/utils";

interface Props {
	lang?: Locale;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const footer = t.common.footer;
const base = import.meta.env.BASE_URL;

const companiesLinks = [
	{ label: footer.columns.companies.links[0], href: getRelativeLocaleUrl(lang, "companies") },
	{ label: footer.columns.companies.links[1], href: `${base}partner-with-us` },
	{ label: footer.columns.companies.links[2], href: "#" },
	{ label: footer.columns.companies.links[3], href: "#" },
];

const hostsLinks = [
	{ label: footer.columns.hosts.links[0], href: `${base}become-a-host` },
	{ label: footer.columns.hosts.links[1], href: getRelativeLocaleUrl(lang, "hosts") },
	{ label: footer.columns.hosts.links[2], href: "#" },
];

const companyLinks = [
	{ label: footer.columns.company.links[0], href: "#" },
	{ label: footer.columns.company.links[1], href: `${base}${lang === "pl" ? "pl/" : ""}blog` },
	{ label: footer.columns.company.links[2], href: `${base}contact` },
];

const legalLinks = footer.columns.legal.links.map((label) => ({ label, href: "#" }));

const socialLinks = [{ label: "LinkedIn", href: "https://www.linkedin.com/company/hellowale" }];

const ctaCards = [
	{
		...footer.ctaCards.companies,
		icon: ctaCompaniesIcon,
		href: getRelativeLocaleUrl(lang, "companies"),
	},
	{ ...footer.ctaCards.hosts, icon: ctaHostsIcon, href: getRelativeLocaleUrl(lang, "hosts") },
	{
		...footer.ctaCards.guests,
		icon: ctaGuestsIcon,
		href: getRelativeLocaleUrl(lang, "professionals"),
	},
];

const copyright = footer.copyright.replace("{year}", String(new Date().getFullYear()));
---

<footer
	class="border-t border-white/15 bg-linear-to-t from-[#914d61] to-[#380121] px-6 pt-10 pb-8 text-white sm:px-10 lg:px-24 lg:pt-14 lg:pb-10"
>
	<div class="mx-auto flex max-w-7xl flex-col gap-10">
		<div class="flex items-center justify-between gap-6">
			<a href={getRelativeLocaleUrl(lang, "")} class="flex w-fit shrink-0 items-center">
				<Image
					src={logoLight}
					alt="hellowale"
					widths={[300, 600]}
					class="aspect-3781/876 h-7 w-auto max-w-none lg:h-8"
				/>
			</a>
			<button
				type="button"
				data-back-to-top
				class="group flex items-center gap-2 sm:gap-4"
				aria-label={footer.backToTop}
			>
				<span
					class="font-display hidden text-base text-white/90 transition-colors group-hover:text-white sm:inline"
					>{footer.backToTop}</span
				>
				<span
					class="flex size-11 shrink-0 items-center justify-center rounded-full border border-white/30 text-xl transition-colors group-hover:border-white group-hover:bg-white/10 sm:size-14"
				>
					↑
				</span>
			</button>
		</div>

		<div class="h-px w-full bg-white/15"></div>

		<div
			class="grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-3 lg:flex lg:flex-nowrap lg:justify-between lg:gap-8"
		>
			<div class="flex flex-col items-start gap-6">
				<p class="font-display text-[17px] font-bold tracking-[-0.034px] text-white">
					{footer.columns.companies.heading}
				</p>
				<nav class="flex flex-col items-start gap-3">
					{
						companiesLinks.map((link) => (
							<a href={link.href} class="font-display text-[15px] text-white/70 hover:text-white">
								{link.label}
							</a>
						))
					}
				</nav>
			</div>

			<div class="flex flex-col items-start gap-6">
				<p class="font-display text-[17px] font-bold tracking-[-0.034px] text-white">
					{footer.columns.hosts.heading}
				</p>
				<nav class="flex flex-col items-start gap-3">
					{
						hostsLinks.map((link) => (
							<a href={link.href} class="font-display text-[15px] text-white/70 hover:text-white">
								{link.label}
							</a>
						))
					}
				</nav>
			</div>

			<div class="flex flex-col items-start gap-6">
				<p class="font-display text-[17px] font-bold tracking-[-0.034px] text-white">
					{footer.columns.company.heading}
				</p>
				<nav class="flex flex-col items-start gap-3">
					{
						companyLinks.map((link) => (
							<a href={link.href} class="font-display text-[15px] text-white/70 hover:text-white">
								{link.label}
							</a>
						))
					}
				</nav>
			</div>

			<div class="flex flex-col items-start gap-6">
				<p class="font-display text-[17px] font-bold tracking-[-0.034px] text-white">
					{footer.columns.legal.heading}
				</p>
				<nav class="flex flex-col items-start gap-3">
					{
						legalLinks.map((link) => (
							<a href={link.href} class="font-display text-[15px] text-white/70 hover:text-white">
								{link.label}
							</a>
						))
					}
				</nav>
			</div>

			<div class="col-span-2 flex flex-col items-start gap-6 sm:col-span-1">
				<div class="flex items-start gap-3">
					{
						socialLinks.map((social) => (
							<a
								href={social.href}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={social.label}
								class="block size-11 shrink-0"
							>
								<svg viewBox="0 0 24 24" class="size-11" fill="none">
									<circle cx="12" cy="12" r="12" fill="#ffe5cc" />
									<g transform="translate(4 4) scale(0.667)">
										<path
											fill="#511a3b"
											d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452z"
										/>
									</g>
								</svg>
							</a>
						))
					}
				</div>
			</div>
		</div>

		<div class="h-px w-full bg-white/15"></div>

		<div class="flex flex-col gap-4 lg:flex-row">
			{
				ctaCards.map((card) => (
					<a
						href={card.href}
						class="flex flex-1 items-center gap-5 rounded-[20px] border border-white/8 bg-white/6 px-6 py-8 transition hover:bg-white/10"
					>
						<img src={card.icon.src} alt="" class="size-14 shrink-0 rounded-full" />
						<div class="flex flex-1 flex-col items-start gap-1">
							<p class="font-display text-[22px] font-bold tracking-[-0.066px] text-white">
								{card.title}
							</p>
							<p class="font-display text-xs leading-normal text-white/70">{card.description}</p>
						</div>
						<span class="flex size-12 shrink-0 items-center justify-center text-lg">→</span>
					</a>
				))
			}
		</div>

		<div class="h-px w-full bg-white/10"></div>

		<div class="flex flex-col items-center gap-8 pt-2 sm:grid sm:grid-cols-3 sm:items-center">
			<p class="font-display text-xs text-white/50 sm:justify-self-start">{copyright}</p>

			<div class="flex flex-col items-center gap-3 sm:justify-self-center">
				<div class="flex items-center gap-4">
					<img
						src={euEmblem.src}
						alt="European Union emblem"
						class="h-10 w-auto shrink-0 border border-white/60"
					/>
					<div class="h-8 w-px bg-white/30"></div>
					<a
						href="https://www.fu-tourism.eu/"
						target="_blank"
						rel="noopener noreferrer"
						class="shrink-0"
					>
						<img src={fuTourismLogo.src} alt="FU-TOURISM" class="h-6 w-auto" />
					</a>
				</div>
				<p class="font-display max-w-xs text-center text-xs text-white/60 italic">
					{footer.euFundingNotice}
				</p>
			</div>

			<p class="font-display text-xs text-white/50 sm:justify-self-end">
				{footer.designedByPrefix}<a
					href="https://greenagency.co"
					target="_blank"
					rel="noopener noreferrer"
					class="transition-colors hover:text-white">{footer.designedByName}</a
				>
			</p>
		</div>
	</div>
</footer>

<script>
	document.querySelectorAll<HTMLButtonElement>("[data-back-to-top]").forEach((button) => {
		button.addEventListener("click", () => {
			window.scrollTo({ top: 0, behavior: "smooth" });
		});
	});
</script>
