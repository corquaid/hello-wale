---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import companiesDoor from "../assets/images/companies-door.jpg";
import benefitIconLowerCost from "../assets/images/benefit-icon-lower-cost.png";
import benefitIconEmployerBranding from "../assets/images/benefit-icon-employer-branding.png";
import benefitIconHigherCreativity from "../assets/images/benefit-icon-higher-creativity.png";
import benefitIconBetterRetention from "../assets/images/benefit-icon-better-retention.png";
import CtaButton from "./CtaButton.astro";

const benefitIcons = [
	benefitIconLowerCost,
	benefitIconEmployerBranding,
	benefitIconHigherCreativity,
	benefitIconBetterRetention,
];

interface Props {
	eyebrow?: string;
	headline?: string;
	subtext?: string;
	image?: ImageMetadata;
	imageAlt?: string;
	imageLayout?: "full" | "compact";
	benefits?: string[];
	ctaLabel?: string;
}

const {
	eyebrow = "For Companies",
	headline = "The wellbeing benefit\nyour team will actually use.",
	subtext = "Workation isn't a perk anymore — it's how the best teams stay sharp, creative, and retained. HelloWale makes it simple to offer.",
	image = companiesDoor,
	imageAlt = "A hotel-style door hanger reading 'Where work doesn't feel like work anymore' on a dark wood door surrounded by jungle greenery",
	imageLayout = "full",
	benefits = ["Lower cost than you think", "Employer branding", "Higher creativity", "Better retention"],
	ctaLabel = "Partner your company",
} = Astro.props;

const isCompact = imageLayout === "compact";
---

<section class:list={["bg-white", isCompact && "px-6 py-16 sm:px-10 lg:px-20 lg:py-24"]}>
	<div
		class:list={[
			"flex flex-col",
			isCompact
				? "mx-auto max-w-7xl gap-10 lg:flex-row lg:items-center lg:gap-16"
				: "lg:flex-row",
		]}
	>
		<div
			class:list={[
				"relative w-full shrink-0 overflow-hidden",
				isCompact
					? "aspect-51/55 rounded-tl-4xl rounded-tr-4xl rounded-bl-4xl lg:w-[45%]"
					: "h-90 sm:h-120 lg:h-auto lg:w-[49%]",
			]}
		>
			<Image
				src={image}
				alt={imageAlt}
				class="absolute inset-0 h-full w-full object-cover"
				widths={[640, 960, 1400, 2048]}
				sizes={isCompact ? "(min-width: 1024px) 45vw, 100vw" : "(min-width: 1024px) 60vw, 100vw"}
			/>
		</div>

		<div
			class:list={[
				"flex flex-1 flex-col items-start justify-center gap-8",
				!isCompact && "px-6 py-16 sm:px-10 lg:px-20 lg:py-24",
			]}
		>
			<div class="flex flex-col items-start gap-6">
				<p
					class="text-wale-700 font-display text-[11px] tracking-[0.33px] uppercase"
				>
					{eyebrow}
				</p>

				<div class="flex flex-col gap-4">
					<h2 class="font-display text-3xl leading-tight tracking-[-0.66px] text-black sm:text-4xl lg:text-[44px] lg:leading-13.5">
						{
							headline.split("\n").map((line, index) => (
								<>
									{index > 0 && <br />}
									{line}
								</>
							))
						}
					</h2>
					<p class="max-w-md font-display text-[17px] leading-7 text-[#5f5f5f]">
						{subtext}
					</p>
				</div>

				<div class="grid w-full max-w-xl grid-cols-1 gap-4 sm:grid-cols-2">
					{
						benefits.map((benefit, index) => (
							<div class="flex items-center gap-2 rounded-xl bg-[#fff3e7] px-5 py-4">
								<img
									src={benefitIcons[index]?.src}
									alt=""
									class="h-8 w-8 shrink-0 object-contain"
								/>
								<p class="font-display text-base font-medium text-wale-700">{benefit}</p>
							</div>
						))
					}
				</div>
			</div>

			<CtaButton label={ctaLabel} />
		</div>
	</div>
</section>
