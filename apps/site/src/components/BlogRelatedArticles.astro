---
import type { CollectionEntry } from "astro:content";
import BlogPostCard from "@/components/BlogPostCard.astro";

interface Props {
	post: CollectionEntry<"blog">;
	allPosts: CollectionEntry<"blog">[];
}

const { post, allPosts } = Astro.props;

const others = allPosts.filter(p => p.id !== post.id).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const sameCategory = others.filter(p => p.data.categories.some(category => post.data.categories.includes(category)));
const rest = others.filter(p => !sameCategory.includes(p));
const related = [...sameCategory, ...rest].slice(0, 4);
---

{
	related.length > 0 && (
		<section class="px-6 py-16 sm:px-10 lg:px-20">
			<div class="mx-auto flex max-w-7xl flex-col items-center gap-10">
				<p class="text-center font-display text-2xl leading-tight text-[#0a1633] sm:text-[32px]">
					More articles you might like
				</p>
				<div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
					{related.map(relatedPost => <BlogPostCard post={relatedPost} />)}
				</div>
			</div>
		</section>
	)
}
